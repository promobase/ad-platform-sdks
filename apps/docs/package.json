{
  "name": "@openpromo/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "reference:check": "bun scripts/check-reference.ts",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "astro sync && nimbus-docs lint",
    "lint:docs": "astro sync && nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "prepreview:cf": "astro build",
    "preview:cf": "wrangler dev",
    "predeploy": "bun run reference:check && astro check && astro build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.8.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@iconify-json/ph": "1.2.2",
    "astro": "7.2.1",
    "astro-icon": "1.1.5",
    "astro-og-canvas": "0.13.0",
    "canvaskit-wasm": "0.41.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.118.0"
  }
}
