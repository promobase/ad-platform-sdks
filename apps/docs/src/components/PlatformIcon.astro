---
/**
 * Inline brand-icon renderer.
 *
 * Path data comes from Simple Icons (CC0), embedded in src/lib/platform-icons.ts.
 * `name` is typed as `PlatformIconName`, so an unknown icon name is a compile
 * error — the `d` attribute can never be empty.
 */
import { PATHS, type PlatformIconName } from "../lib/platform-icons.ts";

interface Props {
  name: PlatformIconName;
  class?: string;
  style?: string;
}

const { name, class: className, style } = Astro.props;
const d = PATHS[name];
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  role="img"
  aria-label={name}
  class={className}
  style={style}
>
  <path d={d} />
</svg>
