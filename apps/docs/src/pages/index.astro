---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PlatformIcon from "../components/PlatformIcon.astro";
import type { PlatformIconName } from "../lib/platform-icons.ts";
import { config } from "virtual:nimbus/config";

interface PlatformTile {
  name: string;
  icon: PlatformIconName;
  color: string;
  endpoints: number;
  package: string;
}

const platforms: PlatformTile[] = [
  { name: "Facebook", icon: "facebook", color: "#0866FF", endpoints: 1451, package: "@openpromo/meta" },
  { name: "Instagram", icon: "instagram", color: "#E4405F", endpoints: 1451, package: "@openpromo/meta" },
  { name: "Threads", icon: "threads", color: "#999999", endpoints: 1451, package: "@openpromo/meta" },
  { name: "TikTok", icon: "tiktok", color: "#25F4EE", endpoints: 531, package: "@openpromo/tiktok" },
  { name: "Snapchat", icon: "snapchat", color: "#FFFC00", endpoints: 214, package: "@openpromo/snapchat" },
  { name: "Reddit", icon: "reddit", color: "#FF4500", endpoints: 40, package: "@openpromo/reddit" },
  { name: "Pinterest", icon: "pinterest", color: "#E60023", endpoints: 266, package: "@openpromo/pinterest" },
  { name: "Amazon Ads", icon: "amazon", color: "#FF9900", endpoints: 166, package: "@openpromo/amazon-ads" },
  { name: "Bluesky", icon: "bluesky", color: "#0285FF", endpoints: 197, package: "@openpromo/bluesky" },
  { name: "LinkedIn", icon: "linkedin", color: "#0A66C2", endpoints: 303, package: "@openpromo/linkedin" },
  { name: "X", icon: "x", color: "#D4D4D8", endpoints: 176, package: "@openpromo/x" },
  { name: "YouTube", icon: "youtube", color: "#FF0000", endpoints: 98, package: "@openpromo/youtube" },
  { name: "Google Ads", icon: "googleads", color: "#4285F4", endpoints: 169, package: "@openpromo/google-ads" },
  { name: "Google Business Profile", icon: "google", color: "#4285F4", endpoints: 139, package: "@openpromo/google-business-profile" },
];

const platformCount = new Set(platforms.map((p) => p.package)).size;
const totalEndpoints = 3750;
const totalModels = 27888;
const totalCapabilities = 987;

const features = [
  {
    title: "Multi-platform support",
    description:
      "Ship to every major ad and social platform from one codebase, without per-platform rewrites.",
  },
  {
    title: "Generated from canonical contracts",
    description:
      "Official specs, lexicons, and Postman collections — never hand-maintained endpoints.",
  },
  {
    title: "Agent-ready by default",
    description:
      "Effect schemas, AI SDK tools, MCP, Code Mode, and CLI all project from one contract.",
  },
] as const;
---

<BaseLayout title={config.title} description={config.description}>
  <div class="min-h-screen bg-background text-foreground">
    <Header />
    <main id="main-content">
      <section class="mx-auto flex max-w-6xl flex-col items-center justify-center px-6 pb-16 pt-24 text-center sm:pt-32">
        <p class="mb-6 font-mono text-xs uppercase tracking-[0.22em] text-muted-foreground">
          Open source · TypeScript · Effect native
        </p>
        <h1 class="max-w-5xl text-balance text-5xl font-semibold leading-[1.02] tracking-[-0.045em] sm:text-7xl">
          One typed SDK family for every ad platform.
        </h1>
        <p class="mt-6 w-full max-w-2xl text-balance text-lg leading-8 text-muted-foreground sm:text-xl">
          {platformCount} ad and social platforms behind one install. Provider-complete,
          typed from canonical contracts, ready for humans and agents.
        </p>
        <div class="mt-10 flex flex-col items-center gap-4">
          <div class="flex items-center gap-3 rounded-lg border border-border bg-card px-5 py-3 font-mono text-sm">
            <span class="text-muted-foreground">$</span>
            <span>bun add @openpromo/ad-platforms</span>
          </div>
          <div class="flex flex-wrap justify-center gap-3">
            <a
              href="/getting-started"
              class="rounded-md bg-primary px-5 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:bg-primary-hover"
            >
              Get started
            </a>
            <a
              href="/reference"
              class="rounded-md border border-border-strong px-5 py-3 text-sm font-medium text-foreground no-underline transition-colors hover:bg-accent"
            >
              Browse API reference
            </a>
          </div>
        </div>
      </section>

      <section class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-6 py-20 text-center">
        <h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
          The platform-agnostic ad toolkit
        </h2>
        <p class="mx-auto max-w-3xl text-balance text-base leading-7 text-muted-foreground sm:text-lg">
          One SDK family that runs on Meta, TikTok, Snapchat, Reddit, Pinterest, Amazon Ads,
          Bluesky, LinkedIn, X, YouTube, Google Ads, and Google Business Profile — and more on the way.
        </p>
        <div class="mx-auto mt-4 flex max-w-2xl flex-wrap items-center justify-center gap-x-6 gap-y-5 sm:max-w-4xl sm:gap-x-8">
          {platforms.map((platform) => (
            <a
              aria-label={`${platform.name} — ${platform.endpoints} endpoints`}
              class="platform-tile group flex flex-col items-center gap-2"
              style={`--pc: ${platform.color}`}
              href="/reference"
              title={`${platform.package} — ${platform.endpoints} endpoints`}
            >
              <PlatformIcon name={platform.icon} class="platform-icon h-9 w-9" />
              <span class="text-xs text-muted-foreground">{platform.name}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-6 py-16">
        <ul class="grid list-none grid-cols-12 gap-x-8 gap-y-10">
          {features.map((feature) => (
            <li class="col-span-12 flex flex-col gap-3 sm:col-span-6 lg:col-span-4">
              <span class="text-lg font-medium text-foreground">{feature.title}</span>
              <span class="text-balance text-sm leading-6 text-muted-foreground sm:max-w-sm">
                {feature.description}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mx-auto max-w-6xl px-6 py-16">
        <div class="grid items-end gap-x-8 gap-y-10 lg:grid-cols-12">
          <h2 class="col-span-12 text-balance text-3xl font-semibold tracking-tight lg:col-span-4 lg:text-4xl">
            Generated, not hand-written
          </h2>
          <p class="col-span-12 text-pretty text-base leading-7 text-muted-foreground lg:col-span-5 lg:col-start-8">
            {totalEndpoints.toLocaleString()} endpoints and {totalModels.toLocaleString()} typed models
            across {platformCount} packages — each generated from the provider's own canonical
            contracts and verified against coverage ledgers on every change.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-lg border border-border bg-card p-5">
            <div class="text-3xl font-semibold tracking-tight">{platformCount}</div>
            <div class="mt-1 text-sm text-muted-foreground">platform packages</div>
          </div>
          <div class="rounded-lg border border-border bg-card p-5">
            <div class="text-3xl font-semibold tracking-tight">{totalEndpoints.toLocaleString()}</div>
            <div class="mt-1 text-sm text-muted-foreground">generated endpoints</div>
          </div>
          <div class="rounded-lg border border-border bg-card p-5">
            <div class="text-3xl font-semibold tracking-tight">{totalModels.toLocaleString()}</div>
            <div class="mt-1 text-sm text-muted-foreground">typed models</div>
          </div>
          <div class="rounded-lg border border-border bg-card p-5">
            <div class="text-3xl font-semibold tracking-tight">{totalCapabilities.toLocaleString()}</div>
            <div class="mt-1 text-sm text-muted-foreground">declared capabilities</div>
          </div>
        </div>
      </section>

      <section class="border-t border-border bg-muted/40">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted-foreground">One contract</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight">Use the boundary your product needs.</h2>
            <p class="mt-4 leading-7 text-muted-foreground">
              Effect schemas and endpoint descriptors remain the source of truth. Promise clients,
              Code Mode, AI SDK, MCP, and CLI are projections of that same contract.
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href="/guides/promise-and-effect" class="rounded-lg border border-border bg-card p-5 no-underline hover:border-border-strong">
              <div class="font-medium text-foreground">Promise + Effect</div>
              <div class="mt-2 text-sm leading-6 text-muted-foreground">Typed errors and cancellation, with a familiar Promise boundary.</div>
            </a>
            <a href="/guides/agent-surfaces" class="rounded-lg border border-border bg-card p-5 no-underline hover:border-border-strong">
              <div class="font-medium text-foreground">Agent surfaces</div>
              <div class="mt-2 text-sm leading-6 text-muted-foreground">Discovery and execution for AI SDK, Code Mode, MCP, and CLI.</div>
            </a>
            <a href="/guides/post-metrics" class="rounded-lg border border-border bg-card p-5 no-underline hover:border-border-strong">
              <div class="font-medium text-foreground">Portable metrics</div>
              <div class="mt-2 text-sm leading-6 text-muted-foreground">Compare common measures while retaining provider-native payloads.</div>
            </a>
            <a href="/guides/openpromo" class="rounded-lg border border-border bg-card p-5 no-underline hover:border-border-strong">
              <div class="font-medium text-foreground">Built for product teams</div>
              <div class="mt-2 text-sm leading-6 text-muted-foreground">Clear SDK and application ownership for durable multi-tenant workflows.</div>
            </a>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-6 py-16">
        <div class="flex flex-col items-center gap-4 text-center">
          <h2 class="text-balance text-3xl font-semibold tracking-tight">Build with Mosaic today</h2>
          <div class="flex items-center gap-3 rounded-lg border border-border bg-card px-5 py-3 font-mono text-sm">
            <span class="text-muted-foreground">$</span>
            <span>bun add @openpromo/ad-platforms</span>
          </div>
          <a
            href="/getting-started"
            class="mt-2 rounded-md bg-primary px-5 py-3 text-sm font-medium text-primary-foreground no-underline transition-colors hover:bg-primary-hover"
          >
            Visit Documentation
          </a>
        </div>
      </section>

      <section class="border-t border-border">
        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 sm:flex-row">
          <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <img src="/mosaic-mark.svg" alt="" width="20" height="20" class="h-5 w-5 shrink-0" />
            <span>
              MIT licensed — built by <a class="text-foreground underline underline-offset-4" href="https://openpromo.app">OpenPromo</a>.
            </span>
          </div>
          <div class="flex flex-wrap justify-center gap-3">
            {platforms.map((platform) => (
              <span class="flex items-center" title={platform.name}>
                <PlatformIcon name={platform.icon} class="h-4 w-4" style={`color: color-mix(in srgb, var(--foreground) 45%, transparent);`} />
              </span>
            ))}
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style is:global>
  /* Brand-color hover for the platform wall: each tile sets --pc to its
     brand color; icons are muted by default and light up on hover. */
  .platform-tile .platform-icon {
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
    transition: color 200ms ease, transform 200ms ease;
  }
  .platform-tile:hover .platform-icon {
    color: var(--pc);
    transform: scale(1.12);
  }
  .platform-tile:hover .platform-icon + span {
    color: var(--foreground);
  }
</style>
