{
  "name": "@openpromo/chat-adapter-instagram",
  "version": "0.11.0",
  "description": "First-party Chat SDK adapter for Instagram DMs, built on @openpromo/meta webhook schemas and the Instagram messaging client",
  "keywords": [
    "chat-sdk",
    "chat-adapter",
    "instagram",
    "meta"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@chat-adapter/shared": "^4.38.0",
    "@openpromo/chat-adapter-core": "workspace:*",
    "@openpromo/meta": "workspace:*"
  },
  "devDependencies": {
    "@chat-adapter/state-memory": "^4.38.0",
    "@types/bun": "latest",
    "chat": "^4.38.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "chat": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/promobase/ad-platform-sdks",
    "directory": "packages/chat-adapter-instagram"
  },
  "publishConfig": {
    "access": "public"
  }
}
