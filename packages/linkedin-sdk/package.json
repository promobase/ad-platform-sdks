{
  "name": "@openpromo/linkedin",
  "version": "0.5.0",
  "description": "Type-safe TypeScript SDK for LinkedIn organic publishing and OAuth",
  "keywords": [
    "linkedin",
    "linkedin-api",
    "marketing-api",
    "social-media",
    "publishing",
    "typescript",
    "type-safe",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/promobase/ad-platform-sdks",
    "directory": "packages/linkedin-sdk"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md"
  ],
  "scripts": {
    "codegen": "bun scripts/generate-effect.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "prepublishOnly": "bun run clean && bun run build",
    "prepack": "node ../../scripts/publish-manifest.mjs prepare",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "typescript": ">=5.9.3 <8"
  },
  "dependencies": {
    "@openpromo/sdk-runtime": "workspace:*",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@openpromo/sdk-codegen": "workspace:*"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./effect": {
      "bun": "./src/generated/effect/index.ts",
      "types": "./dist/generated/effect/index.d.ts",
      "import": "./dist/generated/effect/index.js",
      "default": "./dist/generated/effect/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
