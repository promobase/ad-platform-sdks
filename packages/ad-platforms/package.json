{
  "name": "@openpromo/ad-platforms",
  "version": "0.12.0",
  "description": "Unified type-safe TypeScript SDK for Facebook, Instagram, Threads, WhatsApp, TikTok, LinkedIn, X, YouTube, and future ad platforms — single install, single namespace",
  "keywords": [
    "facebook",
    "instagram",
    "threads",
    "tiktok",
    "tiktok-business",
    "linkedin",
    "x",
    "twitter",
    "youtube",
    "google-ads",
    "ads",
    "advertising",
    "marketing-api",
    "typescript",
    "type-safe",
    "sdk",
    "ad-platforms",
    "business-sdk",
    "ai-sdk",
    "llm-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/promobase/ad-platform-sdks",
    "directory": "packages/ad-platforms"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "prepublishOnly": "bun run clean && bun run build",
    "prepack": "node ../../scripts/publish-manifest.mjs prepare",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "@openpromo/sdk-runtime": "workspace:*",
    "@openpromo/meta": "workspace:*",
    "@openpromo/tiktok": "workspace:*",
    "@openpromo/google-ads": "workspace:*",
    "@openpromo/google-business-profile": "workspace:*",
    "@openpromo/linkedin": "workspace:*",
    "@openpromo/x": "workspace:*",
    "@openpromo/youtube": "workspace:*",
    "@openpromo/snapchat": "workspace:*",
    "effect": "^3.22.1",
    "@openpromo/reddit": "workspace:*",
    "@openpromo/pinterest": "workspace:*",
    "@openpromo/amazon-ads": "workspace:*",
    "@openpromo/bluesky": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.9.3 <8",
    "ai": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai": {
      "bun": "./src/unified-tools.ts",
      "types": "./dist/unified-tools.d.ts",
      "import": "./dist/unified-tools.js",
      "default": "./dist/unified-tools.js"
    },
    "./operations": {
      "bun": "./src/operations/index.ts",
      "types": "./dist/operations/index.d.ts",
      "import": "./dist/operations/index.js",
      "default": "./dist/operations/index.js"
    },
    "./operations/ai": {
      "bun": "./src/operations/ai.ts",
      "types": "./dist/operations/ai.d.ts",
      "import": "./dist/operations/ai.js",
      "default": "./dist/operations/ai.js"
    },
    "./operations/codemode": {
      "bun": "./src/operations/codemode.ts",
      "types": "./dist/operations/codemode.d.ts",
      "import": "./dist/operations/codemode.js",
      "default": "./dist/operations/codemode.js"
    },
    "./effect": {
      "bun": "./src/effect/index.ts",
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js",
      "default": "./dist/effect/index.js"
    },
    "./facebook/effect": {
      "bun": "./src/effect/facebook.ts",
      "types": "./dist/effect/facebook.d.ts",
      "import": "./dist/effect/facebook.js",
      "default": "./dist/effect/facebook.js"
    },
    "./tiktok/effect": {
      "bun": "./src/effect/tiktok.ts",
      "types": "./dist/effect/tiktok.d.ts",
      "import": "./dist/effect/tiktok.js",
      "default": "./dist/effect/tiktok.js"
    },
    "./google-ads/v25/effect": {
      "bun": "./src/effect/google-ads-v25.ts",
      "types": "./dist/effect/google-ads-v25.d.ts",
      "import": "./dist/effect/google-ads-v25.js",
      "default": "./dist/effect/google-ads-v25.js"
    },
    "./google-business-profile/effect": {
      "bun": "./src/effect/google-business-profile.ts",
      "types": "./dist/effect/google-business-profile.d.ts",
      "import": "./dist/effect/google-business-profile.js",
      "default": "./dist/effect/google-business-profile.js"
    },
    "./linkedin/effect": {
      "bun": "./src/effect/linkedin.ts",
      "types": "./dist/effect/linkedin.d.ts",
      "import": "./dist/effect/linkedin.js",
      "default": "./dist/effect/linkedin.js"
    },
    "./x/effect": {
      "bun": "./src/effect/x.ts",
      "types": "./dist/effect/x.d.ts",
      "import": "./dist/effect/x.js",
      "default": "./dist/effect/x.js"
    },
    "./youtube/effect": {
      "bun": "./src/effect/youtube.ts",
      "types": "./dist/effect/youtube.d.ts",
      "import": "./dist/effect/youtube.js",
      "default": "./dist/effect/youtube.js"
    },
    "./x": {
      "bun": "./src/x.ts",
      "types": "./dist/x.d.ts",
      "import": "./dist/x.js",
      "default": "./dist/x.js"
    },
    "./youtube": {
      "bun": "./src/youtube.ts",
      "types": "./dist/youtube.d.ts",
      "import": "./dist/youtube.js",
      "default": "./dist/youtube.js"
    },
    "./facebook": {
      "bun": "./src/facebook.ts",
      "types": "./dist/facebook.d.ts",
      "import": "./dist/facebook.js",
      "default": "./dist/facebook.js"
    },
    "./instagram": {
      "bun": "./src/instagram.ts",
      "types": "./dist/instagram.d.ts",
      "import": "./dist/instagram.js",
      "default": "./dist/instagram.js"
    },
    "./whatsapp": {
      "bun": "./src/whatsapp.ts",
      "types": "./dist/whatsapp.d.ts",
      "import": "./dist/whatsapp.js",
      "default": "./dist/whatsapp.js"
    },
    "./tiktok": {
      "bun": "./src/tiktok.ts",
      "types": "./dist/tiktok.d.ts",
      "import": "./dist/tiktok.js",
      "default": "./dist/tiktok.js"
    },
    "./tiktok/webhooks": {
      "bun": "./src/tiktok-webhooks.ts",
      "types": "./dist/tiktok-webhooks.d.ts",
      "import": "./dist/tiktok-webhooks.js",
      "default": "./dist/tiktok-webhooks.js"
    },
    "./webhooks": {
      "bun": "./src/webhooks.ts",
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "default": "./dist/webhooks.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
