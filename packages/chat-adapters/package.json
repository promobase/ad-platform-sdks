{
  "name": "@openpromo/chat-adapters",
  "version": "0.2.0",
  "description": "Umbrella package for OpenPromo first-party Chat SDK adapters",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@openpromo/chat-adapter-core": "workspace:*",
    "@openpromo/chat-adapter-instagram": "workspace:*",
    "@openpromo/chat-adapter-messenger": "workspace:*",
    "@openpromo/chat-adapter-tiktok": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
