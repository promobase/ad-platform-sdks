{
  "name": "@openpromo/x",
  "version": "0.5.0",
  "description": "Type-safe TypeScript SDK for X API v2 publishing, media upload, and user lookup",
  "keywords": [
    "x",
    "twitter",
    "x-api",
    "twitter-api",
    "social-media",
    "publishing",
    "typescript",
    "type-safe",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/promobase/ad-platform-sdks",
    "directory": "packages/x-sdk"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md"
  ],
  "scripts": {
    "codegen": "cd ../.. && bunx fern-api@5.89.3 generate --local --group x-local --no-prompt --force && bun scripts/patch-fern-x-sdk.mjs && bun scripts/generate-x-effect.mjs",
    "codegen:check": "cd ../.. && bunx fern-api@5.89.3 check",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "prepublishOnly": "bun run clean && bun run build",
    "prepack": "node ../../scripts/publish-manifest.mjs prepare",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "typescript": ">=5.9.3 <8"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generated": {
      "bun": "./src/generated/index.ts",
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.js",
      "default": "./dist/generated/index.js"
    },
    "./tweets": {
      "bun": "./src/tweets.ts",
      "types": "./dist/tweets.d.ts",
      "import": "./dist/tweets.js",
      "default": "./dist/tweets.js"
    },
    "./posts": {
      "bun": "./src/generated/api/resources/posts/exports.ts",
      "types": "./dist/generated/api/resources/posts/exports.d.ts",
      "import": "./dist/generated/api/resources/posts/exports.js",
      "default": "./dist/generated/api/resources/posts/exports.js"
    },
    "./media": {
      "bun": "./src/generated/api/resources/media/exports.ts",
      "types": "./dist/generated/api/resources/media/exports.d.ts",
      "import": "./dist/generated/api/resources/media/exports.js",
      "default": "./dist/generated/api/resources/media/exports.js"
    },
    "./users": {
      "bun": "./src/generated/api/resources/users/exports.ts",
      "types": "./dist/generated/api/resources/users/exports.d.ts",
      "import": "./dist/generated/api/resources/users/exports.js",
      "default": "./dist/generated/api/resources/users/exports.js"
    },
    "./effect": {
      "bun": "./src/generated/effect/index.ts",
      "types": "./dist/generated/effect/index.d.ts",
      "import": "./dist/generated/effect/index.js",
      "default": "./dist/generated/effect/index.js"
    }
  },
  "dependencies": {
    "@openpromo/sdk-runtime": "workspace:*",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@openpromo/sdk-codegen": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
