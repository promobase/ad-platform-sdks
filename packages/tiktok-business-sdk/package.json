{
  "name": "@openpromo/tiktok",
  "version": "0.12.0",
  "description": "Type-safe TypeScript SDK for the TikTok Business API — OAuth, video/photo publishing, comments, and account insights",
  "keywords": [
    "tiktok",
    "tiktok-business-api",
    "tiktok-ads",
    "tiktok-marketing-api",
    "tiktok-sdk",
    "tiktok-api",
    "typescript",
    "type-safe",
    "typed",
    "sdk",
    "api-client",
    "business-sdk",
    "video-publish",
    "content-api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/promobase/ad-platform-sdks",
    "directory": "packages/tiktok-business-sdk"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "codegen": "bun src/codegen/index.ts && node ../../scripts/ensure-generated-headers.mjs",
    "codegen:refresh": "bun src/codegen/index.ts --refresh",
    "codegen:check": "bun run codegen && git -C ../.. diff --exit-code -- packages/tiktok-business-sdk/src/generated apps/docs/src/content/docs/reference/tiktok",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "prepublishOnly": "bun run clean && bun run build",
    "prepack": "node ../../scripts/publish-manifest.mjs prepare",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "@openpromo/sdk-runtime": "workspace:*",
    "effect": "^3.22.1",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openpromo/sdk-codegen": "workspace:*",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "ai": "^6.0.158 || ^7.0.0",
    "typescript": ">=5.9.3 <8"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai": {
      "bun": "./src/ai/index.ts",
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js",
      "default": "./dist/ai/index.js"
    },
    "./webhooks": {
      "bun": "./src/webhooks.ts",
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "default": "./dist/webhooks.js"
    },
    "./generated": {
      "bun": "./src/generated/index.ts",
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.js",
      "default": "./dist/generated/index.js"
    },
    "./generated/types/*": {
      "bun": "./src/generated/types/*.ts",
      "types": "./dist/generated/types/*.d.ts",
      "import": "./dist/generated/types/*.js",
      "default": "./dist/generated/types/*.js"
    },
    "./effect": {
      "bun": "./src/generated/effect/index.ts",
      "types": "./dist/generated/effect/index.d.ts",
      "import": "./dist/generated/effect/index.js",
      "default": "./dist/generated/effect/index.js"
    },
    "./types": {
      "bun": "./src/generated/types/index.ts",
      "types": "./dist/generated/types/index.d.ts",
      "import": "./dist/generated/types/index.js",
      "default": "./dist/generated/types/index.js"
    },
    "./valibot": {
      "bun": "./src/generated/valibot/index.ts",
      "types": "./dist/generated/valibot/index.d.ts",
      "import": "./dist/generated/valibot/index.js",
      "default": "./dist/generated/valibot/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
