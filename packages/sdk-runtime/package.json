{
  "name": "@openpromo/sdk-runtime",
  "version": "0.11.0",
  "description": "Shared runtime primitives for @openpromo ad platform SDKs — fetch-based HttpClient, cursor pagination, rate limiter, retry.",
  "keywords": [
    "sdk-runtime",
    "fetch",
    "http-client",
    "pagination",
    "rate-limit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/promobase/ad-platform-sdks",
    "directory": "packages/sdk-runtime"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "prepublishOnly": "bun run clean && bun run build",
    "prepack": "node ../../scripts/publish-manifest.mjs prepare",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "better-result": "^2.10.0",
    "effect": "^3.22.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": ">=5.9.3 <8"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./effect": {
      "bun": "./src/effect.ts",
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js",
      "default": "./dist/effect.js"
    },
    "./platforms": {
      "bun": "./src/platforms.ts",
      "types": "./dist/platforms.d.ts",
      "import": "./dist/platforms.js",
      "default": "./dist/platforms.js"
    },
    "./oauth": {
      "bun": "./src/oauth.ts",
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js",
      "default": "./dist/oauth.js"
    },
    "./result": {
      "bun": "./src/result.ts",
      "types": "./dist/result.d.ts",
      "import": "./dist/result.js",
      "default": "./dist/result.js"
    },
    "./webhooks": {
      "bun": "./src/webhooks.ts",
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "default": "./dist/webhooks.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
