{
  "name": "@openpromo/meta",
  "version": "0.11.0",
  "description": "Type-safe TypeScript SDK for the Meta (Facebook) Marketing API — fully typed Graph API client with auto-generated types for 985 API objects",
  "keywords": [
    "meta",
    "facebook",
    "meta-business-sdk",
    "facebook-business-sdk",
    "facebook-ads",
    "meta-ads",
    "facebook-marketing-api",
    "meta-marketing-api",
    "graph-api",
    "facebook-graph-api",
    "typescript",
    "type-safe",
    "typed",
    "codegen",
    "ads",
    "advertising",
    "ad-account",
    "campaign",
    "adset",
    "sdk",
    "api-client",
    "business-sdk",
    "facebook-nodejs-business-sdk",
    "facebook-business-sdk-codegen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/promobase/ad-platform-sdks",
    "directory": "packages/meta-business-sdk"
  },
  "module": "./dist/generated/index.js",
  "main": "./dist/generated/index.js",
  "types": "./dist/generated/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "codegen": "bun src/codegen/index.ts && node ../../scripts/ensure-generated-headers.mjs",
    "codegen:check": "bun run codegen && git -C ../.. diff --exit-code -- packages/meta-business-sdk/src/generated apps/docs/src/content/docs/reference/facebook",
    "codegen:enums": "bun scripts/scrape-enums.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "prepublishOnly": "bun run clean && bun run build",
    "prepack": "node ../../scripts/publish-manifest.mjs prepare",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "dependencies": {
    "@openpromo/sdk-runtime": "workspace:*",
    "effect": "^3.22.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@openpromo/sdk-codegen": "workspace:*",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "ai": "^6.0.158 || ^7.0.0",
    "typescript": ">=5.9.3 <8"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "bun": "./src/generated/index.ts",
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.js",
      "default": "./dist/generated/index.js"
    },
    "./ai": {
      "bun": "./src/ai/index.ts",
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js",
      "default": "./dist/ai/index.js"
    },
    "./facebook/effect": {
      "bun": "./src/generated/effect/index.ts",
      "types": "./dist/generated/effect/index.d.ts",
      "import": "./dist/generated/effect/index.js",
      "default": "./dist/generated/effect/index.js"
    },
    "./types": {
      "bun": "./src/generated/types/index.ts",
      "types": "./dist/generated/types/index.d.ts",
      "import": "./dist/generated/types/index.js",
      "default": "./dist/generated/types/index.js"
    },
    "./valibot": {
      "bun": "./src/generated/valibot/index.ts",
      "types": "./dist/generated/valibot/index.d.ts",
      "import": "./dist/generated/valibot/index.js",
      "default": "./dist/generated/valibot/index.js"
    },
    "./webhooks": {
      "bun": "./src/webhooks/index.ts",
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js",
      "default": "./dist/webhooks/index.js"
    },
    "./transports": {
      "bun": "./src/transports/index.ts",
      "types": "./dist/transports/index.d.ts",
      "import": "./dist/transports/index.js",
      "default": "./dist/transports/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
