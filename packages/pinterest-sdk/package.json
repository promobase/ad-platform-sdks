{
  "name": "@mosaic/pinterest",
  "version": "0.1.0",
  "description": "Type-safe TypeScript SDK for the Pinterest REST API v5 (ads, pins, boards, catalogs) and Pinterest OAuth",
  "keywords": [
    "pinterest",
    "pinterest-ads",
    "pins",
    "boards",
    "marketing-api",
    "ads-api",
    "social-media",
    "advertising",
    "typescript",
    "type-safe",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/promobase/ad-platform-sdks",
    "directory": "packages/pinterest-sdk"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md"
  ],
  "scripts": {
    "codegen": "bun src/codegen/index.ts",
    "codegen:refresh": "bun scripts/refresh-spec.ts && bun run codegen",
    "codegen:check": "bun run codegen && git -C ../.. diff --exit-code -- packages/pinterest-sdk/src/generated packages/pinterest-sdk/vendor apps/docs/src/content/docs/reference/pinterest",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "prepublishOnly": "bun run clean && bun run build",
    "prepack": "node ../../scripts/publish-manifest.mjs prepare",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "typescript": ">=5.9.3 <8"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@mosaic/sdk-runtime": "workspace:*",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@mosaic/sdk-codegen": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  }
}
