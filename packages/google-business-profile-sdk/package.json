{
  "name": "@openpromo/google-business-profile",
  "version": "0.4.0",
  "description": "Type-safe TypeScript SDK for Google Business Profile accounts, locations, posts, and performance",
  "keywords": [
    "google-business-profile",
    "local-posts",
    "business-profile",
    "typescript",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/promobase/ad-platform-sdks",
    "directory": "packages/google-business-profile-sdk"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md"
  ],
  "scripts": {
    "codegen": "bun ../../scripts/generate-google-business-profile-sdk.mjs",
    "codegen:refresh": "bun ../../scripts/generate-google-business-profile-sdk.mjs --refresh",
    "codegen:check": "bun run codegen && git -C ../.. diff --exit-code -- packages/google-business-profile-sdk/src/generated apps/docs/src/content/docs/reference/google-business-profile",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "prepublishOnly": "bun run clean && bun run build",
    "prepack": "node ../../scripts/publish-manifest.mjs prepare",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "typescript": ">=5.9.3 <8"
  },
  "dependencies": {
    "@openpromo/sdk-runtime": "workspace:*",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@openpromo/sdk-codegen": "workspace:*"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./effect": {
      "bun": "./src/generated/effect/index.ts",
      "types": "./dist/generated/effect/index.d.ts",
      "import": "./dist/generated/effect/index.js",
      "default": "./dist/generated/effect/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
