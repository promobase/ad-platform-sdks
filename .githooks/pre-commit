#!/bin/sh
# Pre-commit hook: typecheck affected packages, then repo-wide format + lint
# (mirrors what CI's `bun run format:check` / `bun run lint` enforce).

set -e

ROOT="$(git rev-parse --show-toplevel)"

# Get list of staged files
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

check_package() {
  local pkg_dir="$1"
  local pkg_name="$2"

  if echo "$STAGED" | grep -q "^${pkg_dir}/"; then
    echo "[pre-commit] Typechecking ${pkg_name}..."
    cd "$ROOT/$pkg_dir" && bun run typecheck
    echo "[pre-commit] ${pkg_name} OK"
  fi
}

check_package "packages/sdk-runtime" "@openpromo/sdk-runtime"
check_package "packages/meta-business-sdk" "@openpromo/meta"
check_package "packages/tiktok-business-sdk" "@openpromo/tiktok"
check_package "packages/x-sdk" "@openpromo/x"
check_package "packages/chat-adapter-instagram" "@openpromo/chat-adapter-instagram"
check_package "packages/chat-adapter-messenger" "@openpromo/chat-adapter-messenger"
check_package "packages/chat-adapter-tiktok" "@openpromo/chat-adapter-tiktok"

if echo "$STAGED" | grep -qE '\.(ts|tsx|js|jsx|mjs|cjs|json|jsonc)$'; then
  echo "[pre-commit] Checking formatting (oxfmt)..."
  (cd "$ROOT" && bun run format:check)
  echo "[pre-commit] Checking lint (oxlint)..."
  (cd "$ROOT" && bun run lint)
fi

echo "[pre-commit] All checks passed"
