{
  "name": "openpromo-ad-platform-sdks",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter='./packages/*' run build && bun run --cwd apps/docs build",
    "clean": "bun --filter='./packages/*' run clean",
    "typecheck": "bun --filter='./packages/*' run typecheck && bun run --cwd apps/docs typecheck",
    "test": "bun test scripts/ && bun --filter='./packages/*' run test",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .oxfmtrc.json .oxlintrc.json '**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}'",
    "format:check": "oxfmt --check .oxfmtrc.json .oxlintrc.json '**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}'",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check",
    "effect:check": "bun scripts/check-effect-runtime.mjs",
    "docs:check": "bun run --cwd apps/docs reference:check && bun run --cwd apps/docs lint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "ai": "^7.0.0",
    "fern-api": "5.89.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  }
}
